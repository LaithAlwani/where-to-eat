{
  "name": "where-to-eat",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "codegen": "turbo run codegen",
    "convex:dev": "pnpm --filter @repo/backend dev",
    "convex:deploy": "pnpm --filter @repo/backend deploy",
    "seed": "pnpm --filter @repo/backend seed"
  },
  "devDependencies": {
    "turbo": "^2.5.6",
    "typescript": "^5.9.2"
  }
}

# packages/backend/.env.local is written automatically by `npx convex dev`
# (it stores CONVEX_DEPLOYMENT). Do not commit it.
#
# The following are read by Convex functions at runtime and must be set ON THE
# DEPLOYMENT, not in this file:
#
#   npx convex env set SITE_URL http://localhost:3000
#   npx convex env set BETTER_AUTH_SECRET "$(openssl rand -base64 32)"
#
# Cloudflare R2 credentials (from an R2 API token):
#   npx convex env set R2_TOKEN xxxxx
#   npx convex env set R2_ACCESS_KEY_ID xxxxx
#   npx convex env set R2_SECRET_ACCESS_KEY xxxxx
#   npx convex env set R2_ENDPOINT https://<account>.r2.cloudflarestorage.com
#   npx convex env set R2_BUCKET ween-nakol

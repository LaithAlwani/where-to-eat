# Copy to apps/web/.env.local and fill from your Convex dev deployment.
# `npx convex dev` (run in packages/backend) prints these URLs.
NEXT_PUBLIC_CONVEX_URL=https://your-deployment.convex.cloud
NEXT_PUBLIC_CONVEX_SITE_URL=https://your-deployment.convex.site
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Optional: custom Cloudflare R2 public domain for serving images.
# When unset, only *.r2.dev hosts are allowed by next/image.
# R2_PUBLIC_HOST=images.example.com
